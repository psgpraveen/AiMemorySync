# PostgreSQL Database Connection URLs (Supabase / Prisma)
# Replace placeholder values with your actual database credentials
# DATABASE_URL uses transaction pooling (port 6543) for application queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"

# DIRECT_URL uses direct connection (port 5432) for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
