{
  "name": "@aimemory/client-core",
  "version": "0.1.0",
  "description": "Platform-independent client SDK for AiMemorySync",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx test/run-tests.ts"
  },
  "keywords": [
    "aimemory",
    "memory",
    "ai",
    "context",
    "sdk",
    "agentic"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5"
  }
}
