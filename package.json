{
  "name": "aimemorysync",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:sdk": "npm run --workspace=@aimemory/client-core build",
    "build:extension": "npm run --workspace=aimemory-vscode build",
    "typecheck:extension": "npm run --workspace=aimemory-vscode typecheck",
    "watch:extension": "npm run --workspace=aimemory-vscode watch",
    "test:sdk": "npm run --workspace=@aimemory/client-core test",
    "start": "next start",
    "lint": "eslint",
    "key:generate": "npx tsx scripts/generate-api-key.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsup": "^8.4.0",
    "typescript": "^5"
  }
}

