{
  "name": "aimemorysync",
  "version": "0.1.0",
  "description": "Shared AI memory and context synchronization across AI platforms",
  "author": "PSG Praveen (@psgpraveen)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:sdk": "npm run --workspace=@aimemory/client-core build",
    "build:mcp": "npm run --workspace=@aimemory/mcp-server build",
    "build:extension": "npm run --workspace=aimemory-vscode build",
    "build:all": "npm run build:sdk && npm run build:mcp && npm run build:extension && npm run build",
    "typecheck:sdk": "npm run --workspace=@aimemory/client-core typecheck",
    "typecheck:mcp": "npm run --workspace=@aimemory/mcp-server typecheck",
    "typecheck:extension": "npm run --workspace=aimemory-vscode typecheck",
    "typecheck:all": "npm run build:sdk && npm run typecheck && npm run typecheck:sdk && npm run typecheck:mcp && npm run typecheck:extension",
    "test:sdk": "npm run --workspace=@aimemory/client-core test",
    "test:mcp": "npm run --workspace=@aimemory/mcp-server test",
    "test:extension": "npm run --workspace=aimemory-vscode test",
    "test:all": "npm run test:sdk && npm run test:mcp && npm run test:extension",
    "watch:extension": "npm run --workspace=aimemory-vscode watch",
    "package:extension": "npm run --workspace=aimemory-vscode package:extension",
    "package:extension:clean": "npm run --workspace=aimemory-vscode package:extension:clean",
    "version:extension:patch": "npm run --workspace=aimemory-vscode version:patch",
    "version:extension:minor": "npm run --workspace=aimemory-vscode version:minor",
    "version:extension:major": "npm run --workspace=aimemory-vscode version:major",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "key:generate": "npx tsx scripts/generate-api-key.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.4.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsup": "^8.4.0",
    "typescript": "^5"
  }
}
